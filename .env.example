# Copy to `.env` and edit. Every value is optional — these are the defaults.
# The same variables drive local runs and CI (workflow inputs map to them).

# Which sites to run (comma list of site folder names). Blank = all.
#   run `npm run sites` to list discovered sites.
PW_SITES=

# Which browsers to run (comma list): chromium | firefox | webkit
PW_BROWSERS=chromium

# Run with a visible browser window (1/true) or headless (default).
PW_HEADED=0

# Parallelism / stability
PW_WORKERS=          # blank = Playwright default (1 in CI)
PW_RETRIES=          # blank = 0 locally, 2 in CI
PW_FULLY_PARALLEL=1
PW_TIMEOUT=30000     # per-test timeout in ms

# Reporters (comma list): list | line | dot | html | github | blob | json | junit
PW_REPORTER=list

# Trace collection: on | off | retain-on-failure | on-first-retry
PW_TRACE=retain-on-failure

# Only run tests whose title matches this regex.
PW_GREP=

# --- Auth / memory reuse ---------------------------------------------------
# Turn on to run each site's login "setup" project and reuse its saved session.
PW_REUSE_AUTH=0

# --- Per-site settings -----------------------------------------------------
# Each site defines its own env vars in sites/<site>/site.config.js. Base URLs
# and credentials live here (credentials come from repo secrets in CI — never
# commit real values). Examples for the bundled sites:
ACME_BASE_URL=https://acme.example.com
ACME_USER=
ACME_PASS=

GLOBEX_BASE_URL=https://globex.example.com
# globex has no login, so no credentials needed.
