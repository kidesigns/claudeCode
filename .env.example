# Copy to `.env` and edit. Every value is optional — these are the defaults.
# The same variables drive local runs and CI (workflow inputs map to them).

# Which browsers to run (comma list): chromium | firefox | webkit
PW_BROWSERS=chromium

# Run with a visible browser window (1/true) or headless (default).
PW_HEADED=0

# Parallelism / stability
PW_WORKERS=          # blank = Playwright default (1 in CI)
PW_RETRIES=          # blank = 0 locally, 2 in CI
PW_FULLY_PARALLEL=1
PW_TIMEOUT=30000     # per-test timeout in ms

# Base URL your tests navigate against (page.goto('/foo') resolves from this).
PW_BASE_URL=https://example.com

# Reporters (comma list): list | line | dot | html | github | blob | json | junit
PW_REPORTER=list

# Trace collection: on | off | retain-on-failure | on-first-retry
PW_TRACE=retain-on-failure

# Only run tests whose title matches this regex.
PW_GREP=

# --- Auth / memory reuse ---------------------------------------------------
# Turn on to run the login "setup" project and reuse the saved session.
PW_REUSE_AUTH=0
PW_AUTH_STATE=.memory/auth/main.storageState.json

# Login credentials (used by tests/auth.setup.js). In CI these come from
# repository secrets — never commit real values.
SITE_USER=
SITE_PASS=
