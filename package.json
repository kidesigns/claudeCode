{
  "name": "playwright-automation-memory",
  "version": "0.1.0",
  "description": "A JSON-backed memory/state layer for Playwright automations: persistent auth sessions, seen-item dedupe, and a facts/preferences store.",
  "main": "src/memory.js",
  "scripts": {
    "test": "node --test",
    "example": "node examples/scrape-with-memory.js",
    "pw": "playwright test",
    "pw:headed": "PW_HEADED=1 playwright test",
    "pw:all": "PW_BROWSERS=chromium,firefox,webkit playwright test",
    "pw:auth": "PW_REUSE_AUTH=1 playwright test",
    "pw:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "memory",
    "state",
    "storageState",
    "dedupe"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "dotenv": "^17.4.2"
  }
}
